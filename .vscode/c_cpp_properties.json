{
    // 跨平台 (x64 / arm64) 兼容配置
    // 切换:VSCode 底部状态栏点击配置名,或 Ctrl+Shift+P -> "C/C++: Select a Configuration"
    "configurations": [
        {
            "name": "Linux (x64)",
            "includePath": [
                "${workspaceFolder}/3rdparty/**",
                "${workspaceFolder}/3rdparty/rga/include",
                "${workspaceFolder}/**",
                "${workspaceFolder}/devel/include",
                "/opt/ros/${env:ROS_DISTRO}/include",
                "/usr/include/opencv4",
                "/usr/local/include/opencv4",
                "/usr/include/**",
                "/usr/local/include/**",
            ],
            "defines": [
                // 按需补充目标平台的宏,例如嵌入式板子上可能定义的板卡宏
            ],
            // 本机编译场景下 /usr/bin/gcc 在两种架构上都是“当前架构的 gcc”,通用
            // 若做交叉编译,改成 aarch64-linux-gnu-gcc 的绝对路径,例如:
            //   "/usr/bin/aarch64-linux-gnu-gcc"
            "compilerPath": "/usr/bin/g++",
            "cStandard": "c11",
            "cppStandard": "c++17",
            "intelliSenseMode": "linux-gcc-x64",
            // compile_commands.json 会随当前机器上实际编译的架构/路径自动变化,
            // 所以这是天然的跨平台来源;不存在时退回上面的 includePath
            "compileCommands": "${workspaceFolder}/build/compile_commands.json"
        },
        {
            "name": "Linux (ARM64)",
            "includePath": [
                "${workspaceFolder}/**",
                "${workspaceFolder}/devel/include",
                "/opt/ros/${env:ROS_DISTRO}/include",
                "/usr/include/opencv4",
                "/usr/local/include/opencv4",
                "/usr/include/**",
                "/usr/local/include/**"
            ],
            "defines": [],
            "compilerPath": "/usr/bin/gcc",
            "cStandard": "c11",
            "cppStandard": "c++17",
            "intelliSenseMode": "linux-gcc-arm64",
            "compileCommands": "${workspaceFolder}/build/compile_commands.json"
        }
    ],
    "version": 4
}